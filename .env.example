# Copy to .env and fill in. .env is git-ignored.
#
# pnpm start (or docker compose up -d) needs only the model key. Everything else is
# optional: Telegram. The first start prints the owner's login link.

# --- pnpm start: web console and general instance ---
# OWNI_WEB_HOST=127.0.0.1        # 0.0.0.0 in Docker
# OWNI_WEB_PORT=8080
# OWNI_PUBLIC_URL=https://owni.example.it   # behind https: secure cookies, correct login links, and the return address of one-click connectors (/oauth/mcp/callback)
# OWNI_TIME_ZONE=Europe/Rome
# OWNI_INSTANCE_ID=owni
# OWNI_INSTANCE_NAME=Owni
# Telegram user IDs who approve the instance's tools proposti (cards with Approva/Rifiuta).
# OWNI_TELEGRAM_APPROVERS=123456789

# Token from @BotFather. Required for dev:telegram; optional for pnpm start.
TELEGRAM_BOT_TOKEN=

# Model provider of the first instance: anthropic (default), openai, google, xai, mistral, deepseek,
# moonshotai, zai, minimax, meta, openrouter, vercel-ai-gateway, groq, cerebras, together, fireworks,
# huggingface, nvidia, or faux (local deterministic model, no key, for development). See docs/adr/0032.
# The owner can switch any instance to another provider in Impostazioni → Provider.
OWNI_MODEL_PROVIDER=anthropic
# Optional: each provider has a default (anthropic: claude-sonnet-5-5, faux: owni-dev).
OWNI_MODEL_ID=claude-sonnet-5-5

# Official Claude Code / Codex subscriptions on this computer (desktop app sets this itself).
# Local single-tenant development only: loopback host, no OWNI_PUBLIC_URL or OWNI_CELL_SECRET.
# Enable OWNI_LOCAL_PROVIDERS and replace the two model values above with faux / owni-dev:
# the first authenticated subscription is then selected automatically, without an API key.
# OWNI_LOCAL_PROVIDERS=1
# OWNI_MODEL_PROVIDER=faux
# OWNI_MODEL_ID=owni-dev

# The key of the chosen provider is required. Every key set here is usable from the console too.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# XAI_API_KEY=
# MISTRAL_API_KEY=
# DEEPSEEK_API_KEY=
# MOONSHOT_API_KEY=
# ZAI_API_KEY=
# MINIMAX_API_KEY=
# META_API_KEY=
# OPENROUTER_API_KEY=
# AI_GATEWAY_API_KEY=
# GROQ_API_KEY=
# CEREBRAS_API_KEY=
# TOGETHER_API_KEY=
# FIREWORKS_API_KEY=
# HF_TOKEN=
# NVIDIA_API_KEY=

# Optional.
# OWNI_DATA_DIR=data
# OWNI_TENANT_ID=default
# OWNI_INSTANCE_ID=telegram   # dev:telegram default; pnpm start uses "owni"

# Telegram user IDs allowed to talk to the bot, comma-separated (default: nobody).
# Messages from anyone else are dropped without a reply and recorded in the tenant's audit log.
# OWNI_TELEGRAM_ALLOWED_USERS=123456789,987654321

# Optional: Telegram pushes updates to OWNI_PUBLIC_URL/hooks/telegram/<instance> (https) instead of long polling.
# OWNI_TELEGRAM_WEBHOOK_SECRET=

# Optional: people connect their own Google account from the console (read; write with approval if OWNI_GOOGLE_WRITE=1).
# OAuth client of type "Web application"; redirect URI: OWNI_PUBLIC_URL/oauth/google/callback.
# OWNI_GOOGLE_CLIENT_ID=
# OWNI_GOOGLE_CLIENT_SECRET=
# gmail,calendar (default) or one of them. gmail.readonly needs Google's yearly security assessment for a public app.
# OWNI_GOOGLE_SERVICES=calendar
# 1: Owni also prepares mail, replies, drafts and events, done only when the person approves each one (ADR 0021).
# Asks Google for gmail.compose and calendar.events too; people connected before reconnect to grant them.
# OWNI_GOOGLE_WRITE=1

# Optional: Chromium for web_screenshot (Playwright's own browser if unset; the Docker image has it with WITH_BROWSER=1).
# OWNI_CHROMIUM_PATH=/usr/bin/chromium
# Only if Chromium's sandbox cannot start here and you accept running it without (ADR 0009).
# OWNI_SCREENSHOTS_WITHOUT_SANDBOX=1

# Voice messages (Telegram, WhatsApp) transcribed by an OpenAI-compatible service. Mistral (EU):
# OWNI_TRANSCRIBE_URL=https://api.mistral.ai/v1
# OWNI_TRANSCRIBE_API_KEY=
# OWNI_TRANSCRIBE_MODEL=voxtral-mini-latest
# Longest voice message transcribed, 10 to 3600 seconds (Telegram only: WhatsApp does not say).
# OWNI_TRANSCRIBE_MAX_SECONDS=300
# Longer voice notes and audio files are kept as recordings, for audio_transcribe (ADR 0033).
# Time of each passage: mistral (default for api.mistral.ai), openai (default for whisper-1) or none.
# OWNI_TRANSCRIBE_TIMESTAMPS=mistral
# Tell voices apart (Mistral's diarize): 1 by default on Mistral, 0 elsewhere.
# OWNI_TRANSCRIBE_SPEAKERS=1
# Longest recording, 1 to 600 minutes, and minutes of recordings per day per account.
# OWNI_TRANSCRIBE_MAX_MINUTES=180
# OWNI_TRANSCRIBE_MINUTES_PER_DAY=600
# Each instance's owner then allows it in Settings → Messaggi vocali.

# Replies as voice notes to people who send a voice note (ADR 0020), by an OpenAI-compatible
# speech service that answers in OGG Opus. OpenAI:
# OWNI_SPEECH_URL=https://api.openai.com/v1
# OWNI_SPEECH_API_KEY=
# OWNI_SPEECH_MODEL=gpt-4o-mini-tts
# OWNI_SPEECH_VOICE=nova
# Characters of a reply read aloud, 100 to 4000; of a longer one, the first sentences.
# OWNI_SPEECH_MAX_CHARS=1500
# Voice notes per day for the whole server; then replies go as text until the next day.
# OWNI_SPEECH_MAX_PER_DAY=300
# How to speak, for models that take it (gpt-4o-mini-tts).
# OWNI_SPEECH_STYLE=Parla in italiano, tono cordiale e naturale
# Each instance's owner then allows it in Settings → Risposte a voce.

# Pictures on request (ADR 0023, docs/chiavi.md §15), by an OpenAI-compatible image service.
# OWNI_IMAGE_URL=https://api.openai.com/v1
# OWNI_IMAGE_API_KEY=
# OWNI_IMAGE_MODEL=gpt-image-1
# Pictures per day for each account; only pictures made count.
# OWNI_IMAGE_MAX_PER_DAY=100
# Each instance's owner then allows it in Settings → Immagini.

# Web search (Brave Search API, docs/chiavi.md §13). Each owner turns it on in Settings → Ricerca sul web.
# OWNI_SEARCH_API_KEY=
# Only for a service with Brave's API at another address.
# OWNI_SEARCH_URL=https://api.search.brave.com/res/v1/web/search
# Results from this country and in this language unless a search asks otherwise (IT and it by default).
# OWNI_SEARCH_COUNTRY=IT
# OWNI_SEARCH_LANG=it
# Searches per account per day, all its instances together (200 by default).
# OWNI_SEARCH_MAX_PER_DAY=200

# Partita IVA (the EU Commission's VIES, docs/chiavi.md §20): vat_check looks VAT numbers up, with no key.
# Without it vat_check still checks partite IVA, EU VAT numbers and codici fiscali on paper (check digit, office code, form).
# Off unless set. Only the country and the VAT number asked about go to the VIES.
# OWNI_VAT_CHECK=1
# Only for tests or a mirror with the same REST API (GET /ms/{country}/vat/{number}).
# OWNI_VAT_CHECK_URL=https://ec.europa.eu/taxation_customs/vies/rest-api
# Requests to the VIES per account per day, all its instances together (200 by default; answers kept
# in memory, an hour per account and number, do not count). The VIES rate-limits: keep it modest.
# OWNI_VAT_CHECK_MAX_PER_DAY=200
# Requests to the VIES per day for the whole server, every account together (2000 by default):
# the VIES blocks an address that asks too much.
# OWNI_VAT_CHECK_MAX_PER_DAY_SERVER=2000

# Phone calls on a Twilio number (ADR 0012): connected per instance from the console, needs OWNI_PUBLIC_URL in https.
# Twilio's REST API; for data in the EU use the Ireland region, https://api.dublin.ie1.twilio.com.
# OWNI_TWILIO_API=https://api.twilio.com
# Twilio's voice for the spoken replies (everything is said in Italian).
# OWNI_PHONE_VOICE=Polly.Bianca

# The instances' computers (ADR 0013, ADR 0124, runbook 6j): a container each on Docker's default bridge
# (out to the internet, nothing in), on this Docker host.
# The Docker socket is root on this server: only where Owni is the only service. Never in Owni Cloud.
# Build the image first: docker build -f docker/computer.Dockerfile -t owni-computer:latest docker
# OWNI_COMPUTER=docker
# OWNI_COMPUTER_IMAGE=owni-computer:latest
# OWNI_DOCKER_SOCKET=/var/run/docker.sock
# Per computer: memory (128 to 16384 MB), CPUs (0.25 to 16), quota of /work (64 to 102400 MB).
# OWNI_COMPUTER_MEMORY_MB=1024
# OWNI_COMPUTER_CPUS=1
# OWNI_COMPUTER_DISK_MB=2048
# runsc for gVisor, a kernel of its own (installed and registered with Docker first).
# OWNI_COMPUTER_RUNTIME=
# Each instance's owner then turns it on in Settings → Computer.

# The agenti's screens through Cua (ADR 0045, runbook 6n): a Linux desktop with Firefox each, a container
# on this Docker host (amd64 only). Same Docker socket and same warning as the computer. Free, no key:
# docker pull trycua/cua-xfce:0.3.0
# OWNI_DESKTOP=docker
# none (default): no internet. internet: the screens reach it, and their browser is NOT held to the sites allowed.
# OWNI_DESKTOP_NETWORK=none
# Or one Cua desktop run elsewhere, shared by every agente that uses it:
# OWNI_DESKTOP=remote
# OWNI_DESKTOP_URL=https://schermo.example:3211
# OWNI_DESKTOP_TOKEN=
# Each agente's owner then turns it on in Settings → Schermo.

# --- Owni Cloud control plane (pnpm cloud) ---
# Sign-in links by email: any SMTP service. smtps://user:password@host:465, or smtp://...:587 with STARTTLS.
# Without it the links go to data-cloud/mail/outbox.txt.
# OWNI_CLOUD_SMTP_URL=
# OWNI_CLOUD_MAIL_FROM=Owni <accesso@example.it>
# Cells: local (processes, development), docker (one container per tenant, ADR 0008) or railway (runbook 6d).
# OWNI_CLOUD_PROVIDER=docker
# OWNI_CLOUD_DOCKER_IMAGE=owni:local
# OWNI_CLOUD_CELL_MEMORY_MB=512
# RAILWAY_API_TOKEN=
# OWNI_CLOUD_RAILWAY_IMAGE=ghcr.io/<owner>/owni:latest
# OWNI_CLOUD_RAILWAY_WORKSPACE=
# OWNI_CLOUD_RAILWAY_REGION=europe-west4-drams3a
# Subscriptions through Stripe (ADR 0010, runbook 6f). Without the key Owni Cloud is free to use.
# OWNI_CLOUD_STRIPE_SECRET_KEY=
# OWNI_CLOUD_STRIPE_WEBHOOK_SECRET=
# The flat monthly price; optionally a metered price on model cost (1 unit = 1 US cent at list prices) and its meter's event name.
# OWNI_CLOUD_STRIPE_PRICE=
# OWNI_CLOUD_STRIPE_USAGE_PRICE=
# OWNI_CLOUD_STRIPE_METER_EVENT=owni_model_cost
# OWNI_CLOUD_TRIAL_DAYS=14
