{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Owni",
	"version": "0.12.3",
	"identifier": "app.owni.desktop",
	"build": {
		"frontendDist": "../connect"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [],
		"security": {
			"csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"category": "Productivity",
		"shortDescription": "La tua assistente, con il modello AI che vuoi",
		"icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
		"createUpdaterArtifacts": true,
		"macOS": {
			"minimumSystemVersion": "12.0"
		}
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM1NDI0ODE5NUVEQTNBMTQKUldRVU90cGVHVWhDTlFFUzZ0cW5FK0Y4MlpDcDRsaHJMb1BMRXduQTNZVHFVbDRDOFFlb1NvNU8K",
			"endpoints": [
				"https://github.com/mariomile/owni/releases/latest/download/latest.json"
			]
		}
	}
}
