{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "owni/evals/segreteria/lead.schema.json",
  "title": "LeadFields (spec §4.1) - output atteso dall'estrattore Haiku",
  "description": "Campi della spec §4.1. rawSubject, rawSnippet, receivedAt, mailMessageId e ownerUserId sono riempiti dal codice dall'email in ingresso, non dal modello: nel gold non compaiono. title e originalLanguage sono AGGIUNTE proposte (spec §6 titoli e lingua) da confermare con Craft/Ship. A7: phone/email solo se scritti dal mittente; nessun altro dato personale (C.F., data di nascita, IBAN, indirizzo privato) nel lead.",
  "type": "object",
  "required": [
    "fullName",
    "company",
    "email",
    "phone",
    "productOrService",
    "quantity",
    "urgency",
    "missingFields",
    "source"
  ],
  "additionalProperties": false,
  "anyOf": [
    {
      "properties": {
        "fullName": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    {
      "properties": {
        "company": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  ],
  "properties": {
    "fullName": {
      "type": [
        "string",
        "null"
      ]
    },
    "title": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "Dott.",
        "Dott.ssa",
        "Avv.",
        "Ing.",
        "Arch.",
        "Prof.",
        "Prof.ssa",
        "Geom.",
        "Rag."
      ]
    },
    "company": {
      "type": [
        "string",
        "null"
      ]
    },
    "email": {
      "type": [
        "string",
        "null"
      ],
      "format": "email"
    },
    "phone": {
      "type": [
        "string",
        "null"
      ]
    },
    "productOrService": {
      "type": [
        "string",
        "null"
      ]
    },
    "quantity": {
      "type": [
        "string",
        "null"
      ]
    },
    "urgency": {
      "type": [
        "string",
        "null"
      ]
    },
    "missingFields": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/missingField"
      }
    },
    "source": {
      "const": "email"
    },
    "originalLanguage": {
      "type": "string",
      "enum": [
        "it",
        "en",
        "it+en",
        "other"
      ]
    },
    "vatNumber": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(?:[0-9]{11}|[A-Z]{2}[0-9A-Z+*]{2,13})$",
      "description": "Opzionale (A3). Mai chiesta ai privati; chiesta alle aziende solo se tenantConfig.requireVatNumber=true (default false). Solo un numero che passa il controllo formale (italiana: 11 cifre senza IT; estera: con il prefisso del paese); una P.IVA errata resta null e va in missingFields come vatNumberInvalid."
    }
  },
  "$defs": {
    "missingField": {
      "enum": [
        "fullName",
        "company",
        "email",
        "productOrService",
        "quantity",
        "deliverySite",
        "vatNumber",
        "vatNumberInvalid",
        "budget",
        "deadline"
      ]
    }
  }
}