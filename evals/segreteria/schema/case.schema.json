{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "owni/evals/segreteria/case.schema.json",
  "title": "Caso eval segreteria commerciale",
  "type": "object",
  "required": [
    "id",
    "tags",
    "specRefs",
    "email",
    "expected"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9]{3}-[a-z0-9-]+$"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "specRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "notes": {
      "type": "string"
    },
    "email": {
      "type": "object",
      "required": [
        "messageId",
        "from",
        "to",
        "subject",
        "receivedAt",
        "body"
      ],
      "additionalProperties": false,
      "properties": {
        "messageId": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "receivedAt": {
          "type": "string",
          "format": "date-time"
        },
        "body": {
          "type": "string"
        },
        "threadId": {
          "type": "string"
        },
        "inReplyTo": {
          "type": "string"
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "expected": {
      "type": "object",
      "required": [
        "classification",
        "lead",
        "requests",
        "missingFields",
        "draft",
        "flow"
      ],
      "properties": {
        "classification": {
          "enum": [
            "richiesta_preventivo",
            "spam",
            "risposta_thread",
            "non_commerciale"
          ]
        },
        "lead": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "lead.schema.json"
            }
          ]
        },
        "requests": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "productOrService",
              "quantity"
            ],
            "properties": {
              "productOrService": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "quantity": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "missingFields": {
          "type": "array",
          "items": {
            "$ref": "lead.schema.json#/$defs/missingField"
          }
        },
        "draft": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/draft"
            }
          ]
        },
        "flow": {
          "type": "object",
          "required": [
            "praticaAction",
            "crmUpsertExpected",
            "expectedStatusAfterPipeline",
            "telegramButtons",
            "sendAllowedOnlyAfterApprove"
          ],
          "properties": {
            "praticaAction": {
              "enum": [
                "create",
                "create_skip",
                "attach_to_existing",
                "noop_duplicate",
                "log_only",
                "notify_only"
              ]
            },
            "expectedStatusAfterPipeline": {
              "enum": [
                "received",
                "classified_skip",
                "lead_upserted",
                "draft_ready",
                "awaiting_edit",
                "approved",
                "sent",
                "discarded",
                "failed",
                "logged"
              ]
            },
            "telegramButtons": {
              "enum": [
                [
                  "Approva",
                  "Modifica",
                  "Scarta"
                ],
                []
              ]
            },
            "sendAllowedOnlyAfterApprove": {
              "const": true
            },
            "telegramLanguage": {
              "const": "it"
            },
            "leadUpdate": {
              "enum": [
                "same_lead_add_products"
              ]
            }
          }
        },
        "telegramCard": {
          "type": "object"
        },
        "crmMustNotContain": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "tenantConfig": {
      "type": "object",
      "properties": {
        "requireVatNumber": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "draft": {
      "type": "object",
      "required": [
        "register",
        "language",
        "mustAsk",
        "mustNotInventPrices",
        "allowedAmounts",
        "autonomousSend"
      ],
      "properties": {
        "register": {
          "enum": [
            "lei",
            "formal_en"
          ]
        },
        "language": {
          "enum": [
            "it",
            "en"
          ]
        },
        "mustAsk": {
          "type": "array",
          "items": {
            "$ref": "lead.schema.json#/$defs/missingField"
          }
        },
        "mustNotInventPrices": {
          "type": "boolean"
        },
        "allowedAmounts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mustListItemsAsBullets": {
          "type": "boolean"
        },
        "mustAskPriority": {
          "type": "boolean"
        },
        "mustMention": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mustNotMention": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expectedSalutationContains": {
          "type": "string"
        },
        "autonomousSend": {
          "const": false
        },
        "mustNotAskVatNumber": {
          "type": "boolean"
        },
        "piiCheck": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "language": {
                "const": "it"
              }
            }
          },
          "then": {
            "properties": {
              "register": {
                "const": "lei"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "language": {
                "const": "en"
              }
            }
          },
          "then": {
            "properties": {
              "register": {
                "const": "formal_en"
              }
            }
          }
        }
      ]
    }
  }
}