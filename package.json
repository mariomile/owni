{
  "name": "owni",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.22.0"
  },
  "packageManager": "pnpm@10.17.1",
  "dependencies": {
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@modelcontextprotocol/sdk": "1.31.0",
    "playwright-core": "1.56.1",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "scripts": {
    "start": "tsx src/main/owni.ts",
    "owni": "tsx src/main/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest --run",
    "dev:telegram": "tsx src/main/telegram.ts",
    "dev:segreteria": "tsx src/main/segreteria.ts",
    "eval:agente": "pnpm eval:agente:catalog && pnpm eval:agente:outcomes",
    "eval:agente:catalog": "tsx evals/agente/run.ts",
    "eval:agente:outcomes": "tsx evals/agente/outcome-run.ts",
    "eval:agente:real": "tsx evals/agente/real.ts",
    "eval:segreteria": "tsx evals/segreteria/run.ts",
    "eval:segreteria:judge": "tsx evals/segreteria/judge.ts",
    "eval:segreteria:validate": "python3 evals/segreteria/scripts/validate_and_build.py",
    "cloud": "tsx src/main/cloud.ts"
  }
}
