{
  "name": "owni",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.22.0"
  },
  "packageManager": "pnpm@10.17.1",
  "dependencies": {
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "pdfjs-dist": "6.4.299",
    "playwright-core": "1.56.1",
    "pyodide": "314.0.7",
    "tsx": "4.23.15",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "scripts": {
    "start": "tsx src/main/owni.ts",
    "owni": "tsx src/main/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest --run",
    "dev:telegram": "tsx src/main/telegram.ts",
    "eval:agente": "pnpm eval:agente:catalog && pnpm eval:agente:outcomes",
    "eval:agente:catalog": "tsx evals/agente/run.ts",
    "eval:agente:outcomes": "tsx evals/agente/outcome-run.ts",
    "eval:agente:real": "tsx evals/agente/real.ts",
    "eval:agente:conti": "tsx evals/agente/conti.ts",
    "cloud": "tsx src/main/cloud.ts"
  },
  "pnpm": {
    "ignoredOptionalDependencies": [
      "@napi-rs/canvas"
    ]
  }
}
